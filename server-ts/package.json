{
  "name": "voiceops-mcp-server",
  "version": "0.1.0",
  "description": "VoiceOps MCP server: a channel-agnostic command/event engine exposed as MCP tools",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "voiceops-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin.js",
    "db:create": "node --env-file-if-exists=.env --import tsx src/cli/dbBin.ts create",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/cli/dbBin.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/cli/dbBin.ts seed",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/cli/dbBin.ts reset",
    "db:setup": "node --env-file-if-exists=.env --import tsx src/cli/dbBin.ts setup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "local:gate": "npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
